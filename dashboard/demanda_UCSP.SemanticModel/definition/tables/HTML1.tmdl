			    border-radius:8px;
			    padding:16px;
			    font-family:Inter,Arial,sans-serif;
			    display:flex;
			    flex-direction:column;
			    justify-content:space-between;
			'>
			    <div style='
			        display:flex;
			        justify-content:space-between;
			        align-items:flex-start;
			    '>
			        <span style='
			            color:#c6c6cb;
			            font-size:10px;
			            font-weight:500;
			            letter-spacing:0.08em;
			            text-transform:uppercase;
			        '>
			            CUOTA MATRÍCULAS
			        </span>
			
			        <span style='
			            color:#2fd9f4;
			            font-size:16px;
			        '>
			            ●
			        </span>
			    </div>
			
			    <div>
			        <div style='
			            color:#dee2ec;
			            font-size:30px;
			            line-height:36px;
			            font-weight:700;
			            letter-spacing:-0.02em;
			        '>
			            " & CuotaFormateada & "
			        </div>
			
			        <div style='
			            color:#8f9095;
			            font-size:9px;
			            margin-top:3px;
			            letter-spacing:0.05em;
			            text-transform:uppercase;
			        '>
			            MARKET SHARE UCSP
			        </div>
			    </div>
			
			    <div style='
			        border-top:1px solid #30353d;
			        padding-top:7px;
			        display:flex;
			        justify-content:space-between;
			        align-items:center;
			    '>
			        <span style='
			            color:#8f9095;
			            font-size:9px;
			            letter-spacing:0.04em;
			            text-transform:uppercase;
			        '>
			            Participación del mercado
			        </span>
			
			        <span style='
			            color:#c6c6cb;
			            font-size:10px;
			        '>
			            UCSP
			        </span>
			    </div>
			</div>
			"
		lineageTag: c33cd9b4-2bc9-4b84-b806-dc632d2cead2

