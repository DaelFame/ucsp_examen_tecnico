	measure HTML_Ranking_Top3_UCSP =
			
			VAR Universo =
			    ALLSELECTED(
			        'dim_universidad'[NOMBRE_ENTIDAD]
			    )
			
			VAR Top3 =
			    TOPN(
			        3,
			        Universo,
			        [Total Matrículas],
			        DESC,
			        'dim_universidad'[NOMBRE_ENTIDAD],
			        ASC
			    )
			
			VAR Top1 =
			    TOPN(
			        1,
			        Top3,
			        [Total Matrículas],
			        DESC,
			        'dim_universidad'[NOMBRE_ENTIDAD],
			        ASC
			    )
			
			VAR Top2 =
			    TOPN(
			        2,
			        Top3,
			        [Total Matrículas],
			        DESC,
			        'dim_universidad'[NOMBRE_ENTIDAD],
			        ASC
			    )
			
			VAR Top1Nombre =
			    MAXX(
			        Top1,
			        'dim_universidad'[NOMBRE_ENTIDAD]
			    )
			
			VAR Top1Valor =
			    MAXX(
			        Top1,
			        [Total Matrículas]
			    )
			
			VAR Top2Nombre =
			    MAXX(
			        EXCEPT(Top2, Top1),
			        'dim_universidad'[NOMBRE_ENTIDAD]
			    )
			
			VAR Top2Valor =
			    MAXX(
			        EXCEPT(Top2, Top1),
			        [Total Matrículas]
			    )
			
			VAR Top3Nombre =
			    MAXX(
			        EXCEPT(
			            Top3,
			            Top2
			        ),
			        'dim_universidad'[NOMBRE_ENTIDAD]
			    )
			
			VAR Top3Valor =
			    MAXX(
			        EXCEPT(
			            Top3,
			            Top2
			        ),
			        [Total Matrículas]
			    )
			
			VAR UcspValor =
			    CALCULATE(
			        [Total Matrículas],
			        REMOVEFILTERS('dim_universidad'),
			        'dim_universidad'[CODIGO_INEI] = "260000062"
			    )
			
			VAR UcspPosicion =
			    [Posición UCSP Matrículas]
			
			VAR Top1Formateado =
			    FORMAT(Top1Valor, "#,##0")
			
			VAR Top2Formateado =
			    FORMAT(Top2Valor, "#,##0")
			
			VAR Top3Formateado =
			    FORMAT(Top3Valor, "#,##0")
			
			VAR UcspFormateado =
			    FORMAT(UcspValor, "#,##0")
			
			VAR PosicionFormateada =
			    IF(
			        ISBLANK(UcspPosicion),
			        "—",
			        "#" & FORMAT(UcspPosicion, "0")
			    )
			
			RETURN
			"
			<div style='
			    width:100%;
			    height:100%;
			    box-sizing:border-box;
			    background:#171c23;
			    border:1px solid #30353d;
			    border-radius:8px;
			    padding:14px 16px;
			    font-family:Inter,Arial,sans-serif;
			    overflow:hidden;
			'>
			
			    <div style='
			        display:flex;
			        justify-content:space-between;
			        align-items:center;
			        margin-bottom:9px;
			    '>
			        <div style='
			            color:#dee2ec;
			            font-size:10px;
			            font-weight:600;
			            letter-spacing:0.08em;
			            text-transform:uppercase;
			        '>
			            RANKING POR MATRÍCULAS
			        </div>
			
			        <div style='
			            color:#8f9095;
			            font-size:8px;
			            letter-spacing:0.06em;
			            text-transform:uppercase;
			        '>
			            TOP 3 + UCSP
			        </div>
			    </div>
			
			
			    <!-- TOP 1 -->
			    <div style='
			        display:flex;
			        align-items:center;
			        justify-content:space-between;
			        padding:8px 9px;
			        margin-bottom:4px;
			        background:#20262e;
			        border-radius:5px;
			    '>
			
			        <div style='
			            display:flex;
			            align-items:center;
			            gap:9px;
			            min-width:0;
			        '>
			
			            <span style='
			                color:#2fd9f4;
			                font-family:JetBrains Mono,monospace;
			                font-size:15px;
			                font-weight:700;
			                min-width:24px;
			            '>
			                01
			            </span>
			
			            <span style='
			                color:#dee2ec;
			                font-size:11px;
			                font-weight:500;
			                white-space:nowrap;
			                overflow:hidden;
			                text-overflow:ellipsis;
			            '>
			                " & Top1Nombre & "
			            </span>
			
			        </div>
			
			        <span style='
			            color:#ffffff;
			            font-family:JetBrains Mono,monospace;
			            font-size:15px;
			            font-weight:700;
			            margin-left:10px;
			        '>
			            " & Top1Formateado & "
			        </span>
			
			    </div>
			
			
			    <!-- TOP 2 -->
			    <div style='
			        display:flex;
			        align-items:center;
			        justify-content:space-between;
			        padding:8px 9px;
			        margin-bottom:4px;
			        background:#1d232a;
			        border-radius:5px;
			    '>
			
			        <div style='
			            display:flex;
			            align-items:center;
			            gap:9px;
			            min-width:0;
			        '>
			
			            <span style='
			                color:#8f9095;
			                font-family:JetBrains Mono,monospace;
			                font-size:14px;
			                font-weight:600;
			                min-width:24px;
			            '>
			                02
			            </span>
			
			            <span style='
			                color:#c6c6cb;
			                font-size:11px;
			                font-weight:500;
			                white-space:nowrap;
			                overflow:hidden;
			                text-overflow:ellipsis;
			            '>
			                " & Top2Nombre & "
			            </span>
			
			        </div>
			
			        <span style='
			            color:#dee2ec;
			            font-family:JetBrains Mono,monospace;
			            font-size:14px;
			            font-weight:700;
			            margin-left:10px;
			        '>
			            " & Top2Formateado & "
			        </span>
			
			    </div>
			
			
			    <!-- TOP 3 -->
			    <div style='
			        display:flex;
			        align-items:center;
			        justify-content:space-between;
			        padding:8px 9px;
			        margin-bottom:8px;
			        background:#1d232a;
			        border-radius:5px;
			    '>
			
			        <div style='
			            display:flex;
			            align-items:center;
			            gap:9px;
			            min-width:0;
			        '>
			
			            <span style='
			                color:#8f9095;
			                font-family:JetBrains Mono,monospace;
			                font-size:14px;
			                font-weight:600;
			                min-width:24px;
			            '>
			                03
			            </span>
			
			            <span style='
			                color:#c6c6cb;
			                font-size:11px;
			                font-weight:500;
			                white-space:nowrap;
			                overflow:hidden;
			                text-overflow:ellipsis;
			            '>
			                " & Top3Nombre & "
			            </span>
			
			        </div>
			
			        <span style='
			            color:#dee2ec;
			            font-family:JetBrains Mono,monospace;
			            font-size:14px;
			            font-weight:700;
			            margin-left:10px;
			        '>
			            " & Top3Formateado & "
			        </span>
			
			    </div>
			
			
			    <!-- UCSP -->
			    <div style='
			        border-top:1px solid #45474b;
			        padding-top:9px;
			        display:flex;
			        justify-content:space-between;
			        align-items:center;
			    '>
			
			        <div style='
			            display:flex;
			            align-items:center;
			            gap:9px;
			            min-width:0;
			        '>
			
			            <span style='
			                color:#2fd9f4;
			                font-family:JetBrains Mono,monospace;
			                font-size:15px;
			                font-weight:700;
			                min-width:35px;
			            '>
			                " & PosicionFormateada & "
			            </span>
			
			            <span style='
			                color:#dee2ec;
			                font-size:11px;
			                font-weight:700;
			            '>
			                UCSP
			            </span>
			
			        </div>
			
			        <div style='text-align:right;'>
			
			            <div style='
			                color:#2fd9f4;
			                font-family:JetBrains Mono,monospace;
			                font-size:17px;
			                line-height:20px;
			                font-weight:700;
			            '>
			                " & UcspFormateado & "
			            </div>
			
			            <div style='
			                color:#8f9095;
			                font-size:7px;
			                margin-top:1px;
			                letter-spacing:0.05em;
			                text-transform:uppercase;
			            '>
			                MATRÍCULAS UCSP
			            </div>
			
			        </div>
			
			    </div>
			
			</div>
			"
		lineageTag: a17c9b8d-3582-4199-81b7-8f5c26f851a3

	measure HTML_Tendencia_Matriculas =
			
			VAR U2020 =
			    CALCULATE(
			        [Total Matrículas],
			        REMOVEFILTERS('dim_periodo'),
			        REMOVEFILTERS('dim_ubicacion'),
			        REMOVEFILTERS('dim_universidad'),
			        'dim_periodo'[ANIO] = 2020,
			        'dim_universidad'[CODIGO_INEI] = "260000062"
			    )
			
			VAR U2021 =
			    CALCULATE(
			        [Total Matrículas],
			        REMOVEFILTERS('dim_periodo'),
			        REMOVEFILTERS('dim_ubicacion'),
			        REMOVEFILTERS('dim_universidad'),
			        'dim_periodo'[ANIO] = 2021,
			        'dim_universidad'[CODIGO_INEI] = "260000062"
			    )
			
			VAR U2022 =
			    CALCULATE(
			        [Total Matrículas],
			        REMOVEFILTERS('dim_periodo'),
			        REMOVEFILTERS('dim_ubicacion'),
			        REMOVEFILTERS('dim_universidad'),
			        'dim_periodo'[ANIO] = 2022,
			        'dim_universidad'[CODIGO_INEI] = "260000062"
			    )
			
			VAR U2023 =
			    CALCULATE(
			        [Total Matrículas],
			        REMOVEFILTERS('dim_periodo'),
			        REMOVEFILTERS('dim_ubicacion'),
			        REMOVEFILTERS('dim_universidad'),
			        'dim_periodo'[ANIO] = 2023,
			        'dim_universidad'[CODIGO_INEI] = "260000062"
			    )
			
			VAR U2024 =
			    CALCULATE(
			        [Total Matrículas],
			        REMOVEFILTERS('dim_periodo'),
			        REMOVEFILTERS('dim_ubicacion'),
			        REMOVEFILTERS('dim_universidad'),
			        'dim_periodo'[ANIO] = 2024,
			        'dim_universidad'[CODIGO_INEI] = "260000062"
			    )
			
			VAR U2025 =
			    CALCULATE(
			        [Total Matrículas],
			        REMOVEFILTERS('dim_periodo'),
			        REMOVEFILTERS('dim_ubicacion'),
			        REMOVEFILTERS('dim_universidad'),
			        'dim_periodo'[ANIO] = 2025,
			        'dim_universidad'[CODIGO_INEI] = "260000062"
			    )
			
			VAR M2020 =
			    CALCULATE(
			        [Promedio Matrículas Mercado],
			        REMOVEFILTERS('dim_periodo'),
			        'dim_periodo'[ANIO] = 2020
			    )
			
			VAR M2021 =
