table HTML1
	lineageTag: a452d8df-bce4-48df-96e9-51b440de026b

	measure HTML_KPI_Matriculas =
			
			VAR TotalMercado = [Total Matrículas]
			
			VAR UCSPReferencia =
			    CALCULATE(
			        [Total Matrículas],
			        REMOVEFILTERS('dim_ubicacion'),
			        'dim_universidad'[CODIGO_INEI] = "260000062"
			    )
			
			VAR IndiceHipotetico =
			    DIVIDE(UCSPReferencia, TotalMercado)
			
			VAR MercadoFormateado =
			    FORMAT(TotalMercado, "#,##0")
			
			VAR UCSPFormateado =
			    FORMAT(UCSPReferencia, "#,##0")
			
			VAR IndiceFormateado =
			    FORMAT(IndiceHipotetico, "0.0%")
			
			RETURN
			"
			<div style='
			    width:100%;
			    height:100%;
			    box-sizing:border-box;
			    background:#171c23;
			    border:1px solid #30353d;
			    border-radius:7px;
			    padding:11px 14px;
			    font-family:Inter,Arial,sans-serif;
			    display:flex;
			    flex-direction:column;
			    justify-content:space-between;
			    overflow:hidden;
			'>
			
			    <div style='
			        display:flex;
			        justify-content:space-between;
			        align-items:center;
			    '>
			        <span style='
			            color:#c6c6cb;
			            font-size:9px;
			            font-weight:500;
			            letter-spacing:0.08em;
			            text-transform:uppercase;
			        '>
			            MATRÍCULAS
			        </span>
			
			        <span style='
			            color:#2fd9f4;
			            font-size:11px;
			        '>
			            ●
			        </span>
			    </div>
			
			
			    <div>
			        <div style='
			            color:#dee2ec;
			            font-size:25px;
			            line-height:28px;
			            font-weight:700;
			            letter-spacing:-0.02em;
			        '>
			            " & MercadoFormateado & "
			        </div>
			
			        <div style='
			            color:#797d85;
			            font-size:8px;
			            margin-top:1px;
			            letter-spacing:0.06em;
			            text-transform:uppercase;
			        '>
			            TOTAL MERCADO
			        </div>
			    </div>
			
			
			    <div style='
			        height:1px;
			        background:#30353d;
			        margin:3px 0;
			    '></div>
			
			
			    <div style='
			        display:flex;
			        justify-content:space-between;
			        align-items:flex-end;
			    '>
			
			        <div>
			            <div style='
			                color:#dee2ec;
			                font-size:23px;
			                line-height:25px;
			                font-weight:700;
			            '>
			                " & UCSPFormateado & "
			            </div>
			
			            <div style='
			                color:#8f9095;
			                font-size:8px;
			                margin-top:1px;
			                letter-spacing:0.06em;
			                text-transform:uppercase;
			            '>
			                REFERENCIA UCSP
			            </div>
			        </div>
			
			
			        <div style='text-align:right;'>
			            <div style='
			                color:#2fd9f4;
			                font-size:18px;
			                line-height:21px;
			                font-weight:700;
			            '>
			                " & IndiceFormateado & "
			            </div>
			
			            <div style='
			                color:#8f9095;
			                font-size:7px;
			                margin-top:1px;
			                letter-spacing:0.05em;
			                text-transform:uppercase;
			            '>
			                ÍNDICE HIPOTÉTICO
			            </div>
			        </div>
			
			    </div>
			
			
			    <div style='
			        color:#797d85;
			        font-size:7px;
			        line-height:9px;
			        margin-top:2px;
			    '>
			        Comparación del volumen UCSP frente al mercado seleccionado.
			    </div>
			
			</div>
			"
		lineageTag: b83625a1-6f73-411b-9048-138636bc2c1f

