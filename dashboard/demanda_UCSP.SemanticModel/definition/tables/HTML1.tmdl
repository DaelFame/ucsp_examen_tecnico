	measure HTML_Desglose_Programa_UCSP =
			
			VAR ProgramasMercado =
			    ADDCOLUMNS(
			        VALUES('dim_programa'[NOMBRE_PROGRAMA]),
			        "MatriculasMercado",
			            CALCULATE(
			                [Total Matrículas],
			                REMOVEFILTERS('dim_universidad')
			            ),
			        "MatriculasUCSP",
			            CALCULATE(
			                [Total Matrículas],
			                REMOVEFILTERS('dim_universidad'),
			                'dim_universidad'[CODIGO_INEI] = "260000062"
			            )
			    )
			
			VAR ProgramasValidos =
			    FILTER(
			        ProgramasMercado,
			        NOT ISBLANK([MatriculasMercado])
			            && [MatriculasMercado] > 0
			    )
			
			VAR Top8 =
			    TOPN(
			        8,
			        ProgramasValidos,
			        [MatriculasMercado],
			        DESC,
			        'dim_programa'[NOMBRE_PROGRAMA],
			        ASC
			    )
			
			VAR Filas =
			    CONCATENATEX(
			        Top8,
			
			        VAR NombrePrograma =
			            'dim_programa'[NOMBRE_PROGRAMA]
			
			        VAR Mercado =
			            [MatriculasMercado]
			
			        VAR UCSP =
			            [MatriculasUCSP]
			
			        VAR Participacion =
			            DIVIDE(
			                UCSP,
			                Mercado
			            )
			
			        VAR TextoUCSP =
			            IF(
			                ISBLANK(UCSP) || UCSP = 0,
			                "NO DISP.",
			                FORMAT(Participacion, "0.0%")
			            )
			
			        VAR ColorUCSP =
			            IF(
			                ISBLANK(UCSP) || UCSP = 0,
			                "#8f9095",
			                "#2fd9f4"
			            )
			
			        RETURN
			        "
			        <div style='
			            display:grid;
			            grid-template-columns:minmax(0,1fr) 115px 85px;
			            align-items:center;
			            column-gap:14px;
			            min-height:39px;
			            border-bottom:1px solid #30353d;
			        '>
			
			            <div style='
			                color:#dee2ec;
			                font-size:12px;
			                line-height:16px;
			                font-weight:500;
			                white-space:nowrap;
			                overflow:hidden;
			                text-overflow:ellipsis;
			            '>
			                " & NombrePrograma & "
			            </div>
			
			            <div style='
			                color:#ffffff;
			                font-family:JetBrains Mono,monospace;
			                font-size:13px;
			                line-height:16px;
			                font-weight:700;
			                text-align:right;
			            '>
			                " & FORMAT(Mercado, "#,##0") & "
			            </div>
			
			            <div style='
			                color:" & ColorUCSP & ";
			                font-family:JetBrains Mono,monospace;
			                font-size:12px;
			                line-height:15px;
			                font-weight:700;
			                text-align:right;
			            '>
			                " & TextoUCSP & "
			            </div>
			
			        </div>
			        ",
			        "",
			        [MatriculasMercado],
			        DESC
			    )
			
			RETURN
			"
			<div style='
			    width:100%;
			    height:100%;
			    box-sizing:border-box;
			    background:#171c23;
			    border:1px solid #30353d;
			    border-radius:8px;
			    padding:15px 17px;
			    font-family:Inter,Arial,sans-serif;
			    overflow:hidden;
			'>
			
			    <!-- HEADER -->
			
			    <div style='
			        display:flex;
			        justify-content:space-between;
			        align-items:flex-start;
			        margin-bottom:9px;
			    '>
			
			        <div>
			
			            <div style='
			                color:#dee2ec;
			                font-size:13px;
			                line-height:17px;
			                font-weight:700;
			                letter-spacing:0.06em;
			                text-transform:uppercase;
			            '>
			                DESGLOSE POR PROGRAMA
			            </div>
			
			            <div style='
			                color:#8f9095;
			                font-size:9px;
			                line-height:12px;
			                margin-top:3px;
			                letter-spacing:0.05em;
			                text-transform:uppercase;
			            '>
			                MERCADO SELECCIONADO · UCSP
			            </div>
			
			        </div>
			
			        <div style='
			            color:#8f9095;
			            font-size:9px;
			            line-height:12px;
			            font-weight:600;
			            letter-spacing:0.06em;
			            text-transform:uppercase;
			        '>
			            TOP 8
			        </div>
			
			    </div>
			
			
			    <!-- COLUMNAS -->
			
			    <div style='
			        display:grid;
			        grid-template-columns:minmax(0,1fr) 115px 85px;
			        column-gap:14px;
			        padding:6px 0;
			        border-top:1px solid #45474b;
			        border-bottom:1px solid #45474b;
			    '>
			
			        <div style='
			            color:#8f9095;
			            font-size:9px;
			            line-height:11px;
			            font-weight:600;
			            letter-spacing:0.07em;
			            text-transform:uppercase;
			        '>
			            PROGRAMA
			        </div>
			
			        <div style='
			            color:#8f9095;
			            font-size:9px;
			            line-height:11px;
			            font-weight:600;
			            text-align:right;
			            letter-spacing:0.07em;
			            text-transform:uppercase;
			        '>
			            MERCADO
			        </div>
			
			        <div style='
			            color:#2fd9f4;
			            font-size:9px;
			            line-height:11px;
			            font-weight:600;
			            text-align:right;
			            letter-spacing:0.07em;
			            text-transform:uppercase;
			        '>
			            UCSP
			        </div>
			
			    </div>
			
			
			    <!-- FILAS -->
			
			    <div style='
			        height:calc(100% - 70px);
			        overflow:hidden;
			    '>
			
			        " & Filas & "
			
			    </div>
			
			</div>
			"
		lineageTag: 6c1a83ef-259e-4645-8b49-eae2b7c15f8d

	measure HTML_Top5_Programas_Matriculas =
			
			VAR Programas =
			    ADDCOLUMNS(
			        VALUES('dim_programa'[NOMBRE_PROGRAMA]),
			        "Volumen",
			            CALCULATE(
			                [Total Matriculados]
			            )
			    )
			
			VAR Top5 =
			    TOPN(
