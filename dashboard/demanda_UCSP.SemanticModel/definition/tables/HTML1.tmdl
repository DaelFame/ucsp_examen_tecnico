	measure HTML_Evolucion_Demanda_Programas =
			
			VAR ProgramasBase =
			    ADDCOLUMNS(
			        VALUES('dim_programa'[NOMBRE_PROGRAMA]),
			        "Valor2025",
			            CALCULATE(
			                [Total Matriculados],
			                REMOVEFILTERS('dim_periodo'),
			                'dim_periodo'[ANIO] = 2025
			            )
			    )
			
			VAR ProgramasActivos =
			    FILTER(
			        ProgramasBase,
			        NOT ISBLANK([Valor2025])
			            && [Valor2025] > 0
			    )
			
			VAR Top5 =
			    TOPN(
			        5,
			        ProgramasActivos,
			        [Valor2025],
			        DESC,
			        'dim_programa'[NOMBRE_PROGRAMA],
			        ASC
			    )
			
			VAR Total2025 =
			    CALCULATE(
			        [Total Matriculados],
			        REMOVEFILTERS('dim_periodo'),
			        'dim_periodo'[ANIO] = 2025
			    )
			
			VAR Top5Total =
			    SUMX(
			        Top5,
			        [Valor2025]
			    )
			
			VAR ConcentracionTop5 =
			    DIVIDE(
			        Top5Total,
			        Total2025
			    )
			
			VAR Filas =
			    CONCATENATEX(
			        Top5,
			
			        VAR Programa =
			            'dim_programa'[NOMBRE_PROGRAMA]
			
			        VAR V2020 =
			            CALCULATE(
			                [Total Matriculados],
			                REMOVEFILTERS('dim_periodo'),
			                'dim_periodo'[ANIO] = 2020
			            )
			
			        VAR V2021 =
			            CALCULATE(
			                [Total Matriculados],
			                REMOVEFILTERS('dim_periodo'),
			                'dim_periodo'[ANIO] = 2021
			            )
			
			        VAR V2022 =
			            CALCULATE(
			                [Total Matriculados],
			                REMOVEFILTERS('dim_periodo'),
			                'dim_periodo'[ANIO] = 2022
			            )
			
			        VAR V2023 =
			            CALCULATE(
			                [Total Matriculados],
			                REMOVEFILTERS('dim_periodo'),
			                'dim_periodo'[ANIO] = 2023
			            )
			
			        VAR V2024 =
			            CALCULATE(
			                [Total Matriculados],
			                REMOVEFILTERS('dim_periodo'),
			                'dim_periodo'[ANIO] = 2024
			            )
			
			        VAR V2025 =
			            CALCULATE(
			                [Total Matriculados],
			                REMOVEFILTERS('dim_periodo'),
			                'dim_periodo'[ANIO] = 2025
			            )
			
			        VAR MaxFila =
			            MAX(
			                MAX(V2020, V2021),
			                MAX(
			                    MAX(V2022, V2023),
			                    MAX(V2024, V2025)
			                )
			            )
			
			        VAR Nivel2020 =
			            IF(
			                ISBLANK(V2020) || MaxFila = 0,
			                0,
			                DIVIDE(V2020, MaxFila)
			            )
			
			        VAR Nivel2021 =
			            IF(
			                ISBLANK(V2021) || MaxFila = 0,
			                0,
			                DIVIDE(V2021, MaxFila)
			            )
			
			        VAR Nivel2022 =
			            IF(
			                ISBLANK(V2022) || MaxFila = 0,
			                0,
			                DIVIDE(V2022, MaxFila)
			            )
			
			        VAR Nivel2023 =
			            IF(
			                ISBLANK(V2023) || MaxFila = 0,
			                0,
			                DIVIDE(V2023, MaxFila)
			            )
			
			        VAR Nivel2024 =
			            IF(
			                ISBLANK(V2024) || MaxFila = 0,
			                0,
			                DIVIDE(V2024, MaxFila)
			            )
			
			        VAR Nivel2025 =
			            IF(
			                ISBLANK(V2025) || MaxFila = 0,
			                0,
			                DIVIDE(V2025, MaxFila)
			            )
			
			        VAR S1 =
			            SWITCH(
			                TRUE(),
			                Nivel2020 = 0, "·",
			                Nivel2020 < 0.20, "▁",
			                Nivel2020 < 0.35, "▂",
			                Nivel2020 < 0.50, "▃",
			                Nivel2020 < 0.65, "▄",
			                Nivel2020 < 0.80, "▅",
			                Nivel2020 < 0.92, "▆",
			                Nivel2020 < 1, "▇",
			                "█"
			            )
			
			        VAR S2 =
			            SWITCH(
			                TRUE(),
			                Nivel2021 = 0, "·",
			                Nivel2021 < 0.20, "▁",
			                Nivel2021 < 0.35, "▂",
			                Nivel2021 < 0.50, "▃",
			                Nivel2021 < 0.65, "▄",
			                Nivel2021 < 0.80, "▅",
			                Nivel2021 < 0.92, "▆",
			                Nivel2021 < 1, "▇",
			                "█"
			            )
			
			        VAR S3 =
			            SWITCH(
			                TRUE(),
			                Nivel2022 = 0, "·",
			                Nivel2022 < 0.20, "▁",
			                Nivel2022 < 0.35, "▂",
			                Nivel2022 < 0.50, "▃",
			                Nivel2022 < 0.65, "▄",
			                Nivel2022 < 0.80, "▅",
			                Nivel2022 < 0.92, "▆",
			                Nivel2022 < 1, "▇",
			                "█"
			            )
			
			        VAR S4 =
			            SWITCH(
			                TRUE(),
			                Nivel2023 = 0, "·",
			                Nivel2023 < 0.20, "▁",
			                Nivel2023 < 0.35, "▂",
			                Nivel2023 < 0.50, "▃",
			                Nivel2023 < 0.65, "▄",
			                Nivel2023 < 0.80, "▅",
			                Nivel2023 < 0.92, "▆",
			                Nivel2023 < 1, "▇",
			                "█"
			            )
			
			        VAR S5 =
			            SWITCH(
			                TRUE(),
			                Nivel2024 = 0, "·",
			                Nivel2024 < 0.20, "▁",
			                Nivel2024 < 0.35, "▂",
			                Nivel2024 < 0.50, "▃",
			                Nivel2024 < 0.65, "▄",
			                Nivel2024 < 0.80, "▅",
			                Nivel2024 < 0.92, "▆",
			                Nivel2024 < 1, "▇",
			                "█"
			            )
			
			        VAR S6 =
			            SWITCH(
			                TRUE(),
			                Nivel2025 = 0, "·",
			                Nivel2025 < 0.20, "▁",
			                Nivel2025 < 0.35, "▂",
			                Nivel2025 < 0.50, "▃",
			                Nivel2025 < 0.65, "▄",
			                Nivel2025 < 0.80, "▅",
			                Nivel2025 < 0.92, "▆",
			                Nivel2025 < 1, "▇",
			                "█"
			            )
			
			        VAR Sparkline =
			            S1 & S2 & S3 & S4 & S5 & S6
			
			        VAR Cambio =
			            DIVIDE(
			                V2025 - V2020,
			                V2020
			            )
			
			        VAR Icono =
			            SWITCH(
			                TRUE(),
			                ISBLANK(Cambio), "—",
			                Cambio > 0.05, "↑",
			                Cambio < -0.05, "↓",
			                "→"
			            )
			
			        VAR ColorTendencia =
			            SWITCH(
			                TRUE(),
			                ISBLANK(Cambio), "#8f9095",
			                Cambio > 0.05, "#2fd9f4",
			                Cambio < -0.05, "#ffb4ab",
			                "#8f9095"
			            )
			
			        RETURN
			        "
			        <div style='
			            display:grid;
			            grid-template-columns:190px minmax(100px,1fr) 85px 38px;
			            align-items:center;
			            gap:12px;
			            min-height:36px;
			            border-bottom:1px solid #30353d;
			        '>
			
			            <div style='
			                color:#dee2ec;
			                font-size:11px;
			                line-height:14px;
			                font-weight:500;
			                white-space:nowrap;
			                overflow:hidden;
			                text-overflow:ellipsis;
			            '>
			                " & Programa & "
			            </div>
			
			            <div style='
			                color:#2fd9f4;
			                font-family:JetBrains Mono,monospace;
			                font-size:19px;
			                line-height:20px;
			                letter-spacing:0;
			                white-space:nowrap;
			                overflow:hidden;
			            '>
			                " & Sparkline & "
			            </div>
			
			            <div style='
			                color:#ffffff;
			                font-family:JetBrains Mono,monospace;
			                font-size:12px;
			                font-weight:700;
			                text-align:right;
			            '>
			                " & FORMAT(V2025, "#,##0") & "
			            </div>
			
			            <div style='
			                color:" & ColorTendencia & ";
			                font-family:JetBrains Mono,monospace;
			                font-size:15px;
			                font-weight:700;
			                text-align:center;
			            '>
			                " & Icono & "
			            </div>
			
			        </div>
			        ",
			        "",
			        [Valor2025],
			        DESC
			    )
			
			RETURN
			"
			<div style='
			    width:100%;
			    height:100%;
			    box-sizing:border-box;
			    background:#171c23;
			    border:1px solid #30353d;
			    border-radius:8px;
			    padding:15px 17px;
			    font-family:Inter,Arial,sans-serif;
			    overflow:hidden;
			'>
			
			    <!-- HEADER -->
			
			    <div style='
			        display:flex;
			        justify-content:space-between;
			        align-items:flex-start;
			        margin-bottom:8px;
			    '>
			
			        <div>
			
			            <div style='
			                color:#dee2ec;
			                font-size:14px;
			                line-height:18px;
			                font-weight:700;
			                letter-spacing:0.06em;
			                text-transform:uppercase;
			            '>
			                EVOLUCIÓN DE LA DEMANDA
			            </div>
			
			            <div style='
			                color:#8f9095;
			                font-size:9px;
			                line-height:12px;
			                margin-top:3px;
			                letter-spacing:0.05em;
			                text-transform:uppercase;
			            '>
			                TOP 5 PROGRAMAS · MATRÍCULAS · 2020–2025
			            </div>
			
			        </div>
			
			        <div style='
			            text-align:right;
			        '>
			
			            <div style='
			                color:#2fd9f4;
			                font-family:JetBrains Mono,monospace;
			                font-size:20px;
			                line-height:22px;
			                font-weight:700;
			            '>
			                " & FORMAT(ConcentracionTop5, "0.0%") & "
			            </div>
			
			            <div style='
			                color:#8f9095;
			                font-size:8px;
			                line-height:10px;
			                margin-top:2px;
			                letter-spacing:0.05em;
			                text-transform:uppercase;
			            '>
			                CONCENTRACIÓN TOP 5
			            </div>
			
			        </div>
			
			    </div>
			
			
			    <!-- HEADER TABLA -->
			
			    <div style='
			        display:grid;
			        grid-template-columns:190px minmax(100px,1fr) 85px 38px;
			        align-items:center;
			        gap:12px;
			        padding:6px 0;
			        border-top:1px solid #45474b;
			        border-bottom:1px solid #45474b;
			    '>
			
			        <div style='
			            color:#8f9095;
			            font-size:8px;
			            font-weight:600;
			            letter-spacing:0.06em;
			            text-transform:uppercase;
			        '>
			            PROGRAMA
			        </div>
			
			        <div style='
			            color:#8f9095;
			            font-size:8px;
			            font-weight:600;
			            letter-spacing:0.06em;
			            text-transform:uppercase;
			        '>
			            EVOLUCIÓN 2020 → 2025
			        </div>
			
			        <div style='
			            color:#8f9095;
			            font-size:8px;
			            font-weight:600;
			            text-align:right;
			            letter-spacing:0.06em;
			            text-transform:uppercase;
			        '>
			            2025
			        </div>
			
			        <div style='
			            color:#8f9095;
			            font-size:8px;
			            font-weight:600;
			            text-align:center;
			            letter-spacing:0.06em;
			            text-transform:uppercase;
			        '>
			            Δ
			        </div>
			
			    </div>
			
			
			    <!-- FILAS -->
			
			    <div style='
			        height:calc(100% - 72px);
			        overflow:hidden;
			    '>
			        " & Filas & "
			    </div>
			
			</div>
			"
		lineageTag: a3d95816-5be6-483c-b1a7-7394c7ab2ac5

	measure HTML_KPI_Brecha_Lider =
			
			VAR Lider =
			    [Universidad Líder Matrículas]
			
			VAR MatriculasLider =
			    [Matrículas Líder]
			
			VAR MatriculasUCSP =
			    [Total Matrículas UCSP]
			
			VAR Brecha =
			    [Brecha Matrículas vs Líder]
			
			VAR BrechaAbsoluta =
			    ABS(Brecha)
			
			VAR BrechaPorcentual =
			    DIVIDE(
			        MatriculasUCSP - MatriculasLider,
			        MatriculasLider
			    )
			
			VAR LiderFormateado =
			    FORMAT(
			        MatriculasLider,
			        "#,##0"
			    )
			
			VAR UCSPFormateado =
			    FORMAT(
			        MatriculasUCSP,
			        "#,##0"
			    )
			
			VAR BrechaFormateada =
			    FORMAT(
			        BrechaAbsoluta,
			        "#,##0"
			    )
			
			VAR BrechaPctFormateada =
			    FORMAT(
			        ABS(BrechaPorcentual),
			        "0.0%"
			    )
			
			VAR Direccion =
			    SWITCH(
			        TRUE(),
			        Brecha < 0, "▼",
			        Brecha > 0, "▲",
			        "＝"
			    )
			
			VAR ColorBrecha =
			    SWITCH(
			        TRUE(),
			        Brecha < 0, "#ffb4ab",
			        Brecha > 0, "#2fd9f4",
			        "#8f9095"
			    )
			
			VAR TextoBrecha =
			    SWITCH(
			        TRUE(),
			        Brecha < 0, "POR DEBAJO DEL LÍDER",
			        Brecha > 0, "POR ENCIMA DEL LÍDER",
			        "MISMO VOLUMEN DEL LÍDER"
			    )
			
			RETURN
			"
			<div style='
			    width:100%;
			    height:100%;
			    box-sizing:border-box;
			    background:#171c23;
			    border:1px solid #30353d;
			    border-radius:8px;
			    padding:15px 17px;
			    font-family:Inter,Arial,sans-serif;
			    overflow:hidden;
			    display:flex;
			    flex-direction:column;
			    justify-content:space-between;
			'>
			
			    <!-- HEADER -->
			
			    <div style='
			        display:flex;
			        justify-content:space-between;
			        align-items:flex-start;
			    '>
			
			        <div>
			
			            <div style='
			                color:#dee2ec;
			                font-size:13px;
			                line-height:17px;
			                font-weight:700;
			                letter-spacing:0.06em;
			                text-transform:uppercase;
			            '>
			                BRECHA VS. LÍDER
			            </div>
			
			            <div style='
			                color:#8f9095;
			                font-size:8px;
			                line-height:11px;
			                margin-top:3px;
			                letter-spacing:0.05em;
			                text-transform:uppercase;
			            '>
			                MATRÍCULAS · CONTEXTO ACTUAL
			            </div>
			
			        </div>
			
			        <span style='
			            color:#2fd9f4;
			            font-size:14px;
			            line-height:14px;
			        '>
			            ●
			        </span>
			
			    </div>
			
			
			    <!-- BRECHA PRINCIPAL -->
			
			    <div style='
			        display:flex;
			        align-items:baseline;
			        gap:9px;
			        margin-top:4px;
			    '>
			
			        <span style='
			            color:" & ColorBrecha & ";
			            font-family:JetBrains Mono,monospace;
			            font-size:15px;
			            font-weight:700;
			        '>
			            " & Direccion & "
			        </span>
			
			        <span style='
			            color:#ffffff;
			            font-family:JetBrains Mono,monospace;
			            font-size:27px;
			            line-height:30px;
			            font-weight:700;
			            letter-spacing:-0.02em;
			        '>
			            " & BrechaFormateada & "
			        </span>
			
			    </div>
			
			    <div style='
			        color:" & ColorBrecha & ";
			        font-size:8px;
			        line-height:10px;
			        font-weight:600;
			        letter-spacing:0.06em;
			        text-transform:uppercase;
			        margin-top:1px;
			    '>
			        " & TextoBrecha & "
			    </div>
			
			
			    <!-- COMPARACIÓN -->
			
			    <div style='
			        border-top:1px solid #30353d;
			        margin-top:7px;
			        padding-top:7px;
			    '>
			
			        <div style='
			            display:flex;
			            justify-content:space-between;
			            align-items:center;
			            margin-bottom:5px;
			        '>
			
			            <span style='
			                color:#8f9095;
			                font-size:8px;
			                letter-spacing:0.05em;
			                text-transform:uppercase;
			            '>
			                LÍDER
			            </span>
			
			            <span style='
			                color:#dee2ec;
			                font-size:10px;
			                font-weight:600;
			                max-width:210px;
			                white-space:nowrap;
			                overflow:hidden;
			                text-overflow:ellipsis;
			            '>
			                " & Lider & "
			            </span>
			
			        </div>
			
			
			        <div style='
			            display:flex;
			            justify-content:space-between;
			            align-items:center;
			            margin-bottom:5px;
			        '>
			
			            <span style='
			                color:#8f9095;
			                font-size:8px;
			                letter-spacing:0.05em;
			                text-transform:uppercase;
			            '>
			                UCSP
			            </span>
			
			            <span style='
			                color:#2fd9f4;
			                font-family:JetBrains Mono,monospace;
			                font-size:12px;
			                font-weight:700;
			            '>
			                " & UCSPFormateado & "
			            </span>
			
			        </div>
			
			
			        <div style='
			            display:flex;
			            justify-content:space-between;
			            align-items:center;
			        '>
			
			            <span style='
			                color:#8f9095;
			                font-size:8px;
			                letter-spacing:0.05em;
			                text-transform:uppercase;
			            '>
			                DIFERENCIA
			            </span>
			
			            <span style='
			                color:#c6c6cb;
			                font-family:JetBrains Mono,monospace;
			                font-size:10px;
			                font-weight:600;
			            '>
			                " & BrechaPctFormateada & "
			            </span>
			
			        </div>
			
			    </div>
			
			</div>
			"
		lineageTag: d1b343dc-22f9-4f0b-b3c7-9f2135ba3baa

	measure HTML_Executive_Insight =
			
			VAR ProgramasBase =
			    ADDCOLUMNS(
			        VALUES('dim_programa'[NOMBRE_PROGRAMA]),
			        "Volumen",
			            CALCULATE(
			                [Total Matriculados]
			            )
			    )
			
			VAR ProgramasActivos =
			    FILTER(
			        ProgramasBase,
			        NOT ISBLANK([Volumen])
			            && [Volumen] > 0
			    )
			
			VAR Top5 =
			    TOPN(
			        5,
			        ProgramasActivos,
			        [Volumen],
			        DESC,
			        'dim_programa'[NOMBRE_PROGRAMA],
			        ASC
			    )
			
			VAR Top3 =
			    TOPN(
			        3,
			        ProgramasActivos,
			        [Volumen],
			        DESC,
			        'dim_programa'[NOMBRE_PROGRAMA],
			        ASC
			    )
			
			VAR Programa1 =
			    MAXX(
			        TOP3,
			        'dim_programa'[NOMBRE_PROGRAMA]
			    )
			
			VAR Programa2 =
			    MAXX(
			        EXCEPT(
			            TOP3,
			            TOPN(
			                1,
			                TOP3,
			                [Volumen],
			                DESC,
			                'dim_programa'[NOMBRE_PROGRAMA],
			                ASC
			            )
			        ),
			        'dim_programa'[NOMBRE_PROGRAMA]
			    )
			
			VAR Programa3 =
			    MAXX(
			        EXCEPT(
			            TOP3,
			            TOPN(
			                2,
			                TOP3,
			                [Volumen],
			                DESC,
			                'dim_programa'[NOMBRE_PROGRAMA],
			                ASC
			            )
			        ),
			        'dim_programa'[NOMBRE_PROGRAMA]
			    )
			
			VAR TotalDemanda =
			    [Total Matriculados]
			
			VAR TotalTop5 =
			    SUMX(
			        Top5,
			        [Volumen]
			    )
			
			VAR Concentracion =
			    DIVIDE(
			        TotalTop5,
			        TotalDemanda
			    )
			
			VAR ConcentracionFormateada =
			    FORMAT(
			        Concentracion,
			        "0.0%"
			    )
			
			VAR PosicionUCSP =
			    [Posición UCSP Matrículas]
			
			VAR Lider =
			    [Universidad Líder Matrículas]
			
			VAR InsightPrincipal =
			    SWITCH(
			        TRUE(),
			
			        ISBLANK(TotalDemanda)
			            || TotalDemanda = 0,
			        "No existe demanda registrada para el contexto seleccionado.",
			
			        "La demanda se concentra principalmente en "
			            & Programa1
			            & ", "
			            & Programa2
			            & " e "
			            & Programa3
			            & "."
			    )
			
			VAR InsightSecundario =
			    IF(
			        ISBLANK(Concentracion),
			        "No es posible calcular la concentración Top 5.",
			        "Los 5 programas principales concentran el "
			            & ConcentracionFormateada
			            & " de la demanda del contexto seleccionado."
			    )
			
			VAR InsightCompetitivo =
			    IF(
			        ISBLANK(PosicionUCSP),
			        "",
			        "La UCSP ocupa la posición #"
			            & FORMAT(PosicionUCSP, "0")
			            & " frente al mercado seleccionado."
			    )
			
			RETURN
			"
			<div style='
			    width:100%;
			    height:100%;
			    box-sizing:border-box;
			    background:#171c23;
			    border:1px solid #30353d;
			    border-radius:8px;
			    padding:15px 17px;
			    font-family:Inter,Arial,sans-serif;
			    overflow:hidden;
			    display:flex;
			    flex-direction:column;
			    justify-content:space-between;
			'>
			
			    <!-- HEADER -->
			
			    <div style='
			        display:flex;
			        justify-content:space-between;
			        align-items:center;
			    '>
			
			        <div>
			
			            <div style='
			                color:#2fd9f4;
			                font-size:10px;
			                line-height:13px;
			                font-family:JetBrains Mono,monospace;
			                font-weight:600;
			                letter-spacing:0.08em;
			                text-transform:uppercase;
			            '>
			                EXECUTIVE INSIGHT
			            </div>
			
			            <div style='
			                color:#8f9095;
			                font-size:8px;
			                margin-top:2px;
			                letter-spacing:0.05em;
			                text-transform:uppercase;
			            '>
			                LECTURA AUTOMÁTICA · CONTEXTO ACTUAL
			            </div>
			
			        </div>
			
			        <span style='
			            color:#2fd9f4;
			            font-size:13px;
			        '>
			            ●
			        </span>
			
			    </div>
			
			
			    <!-- INSIGHT PRINCIPAL -->
			
			    <div style='
			        margin-top:10px;
			    '>
			
			        <div style='
			            color:#dee2ec;
			            font-size:14px;
			            line-height:20px;
			            font-weight:600;
			        '>
			            " & InsightPrincipal & "
			        </div>
			
			    </div>
			
			
			    <!-- INSIGHT SECUNDARIO -->
			
			    <div style='
			        border-left:2px solid #2fd9f4;
			        padding-left:10px;
			        margin-top:9px;
			    '>
			
			        <div style='
			            color:#c6c6cb;
			            font-size:10px;
			            line-height:15px;
			        '>
			            " & InsightSecundario & "
			        </div>
			
			    </div>
			
			
			    <!-- COMPETITIVE -->
			
			    <div style='
			        border-top:1px solid #30353d;
			        padding-top:8px;
			        margin-top:8px;
			        display:flex;
			        justify-content:space-between;
			        align-items:center;
			        gap:12px;
			    '>
			
			        <div style='
			            color:#8f9095;
			            font-size:8px;
			            line-height:11px;
			            letter-spacing:0.04em;
			            text-transform:uppercase;
			        '>
			            " & InsightCompetitivo & "
			        </div>
			
			        <div style='
			            text-align:right;
			            flex-shrink:0;
			        '>
			
			            <div style='
			                color:#2fd9f4;
			                font-family:JetBrains Mono,monospace;
			                font-size:18px;
			                line-height:20px;
			                font-weight:700;
			            '>
			                " & ConcentracionFormateada & "
			            </div>
			
			            <div style='
			                color:#8f9095;
			                font-size:7px;
			                line-height:9px;
			                letter-spacing:0.05em;
			                text-transform:uppercase;
			            '>
			                TOP 5
			            </div>
			
			        </div>
			
			    </div>
			
			</div>
			"
		lineageTag: 67b6ae4c-9973-4527-8d12-ab0bd1f51637

	measure HTML_Oportunidades_Mercado =
			
			VAR ProgramasBase =
			    ADDCOLUMNS(
			        VALUES('dim_programa'[NOMBRE_PROGRAMA]),
			
			        "Mercado",
			            CALCULATE(
			                [Total Matriculados],
			                REMOVEFILTERS('dim_universidad')
			            ),
			
			        "UCSP",
			            CALCULATE(
			                [Total Matrículas],
			                REMOVEFILTERS('dim_universidad'),
			                'dim_universidad'[CODIGO_INEI] = "260000062"
			            )
			    )
			
			VAR ProgramasActivos =
			    FILTER(
			        ProgramasBase,
			        NOT ISBLANK([Mercado])
			            && [Mercado] > 0
			    )
			
			VAR ProgramasOportunidad =
			    FILTER(
			        ProgramasActivos,
			        ISBLANK([UCSP])
			            || [UCSP] = 0
			            || DIVIDE([UCSP], [Mercado]) < 0.15
			    )
			
			VAR Top5Oportunidades =
			    TOPN(
			        5,
			        ProgramasOportunidad,
			        [Mercado],
			        DESC,
			        'dim_programa'[NOMBRE_PROGRAMA],
			        ASC
			    )
			
			VAR Filas =
			    CONCATENATEX(
			        Top5Oportunidades,
			
			        VAR Programa =
			            'dim_programa'[NOMBRE_PROGRAMA]
			
			        VAR ValorMercado =
			            [Mercado]
			
			        VAR ValorUCSP =
			            [UCSP]
			
			        VAR Participacion =
			            DIVIDE(
			                ValorUCSP,
			                ValorMercado
			            )
			
			        VAR Estado =
			            SWITCH(
			                TRUE(),
			
			                ISBLANK(ValorUCSP)
			                    || ValorUCSP = 0,
			                "SIN PRESENCIA",
			
			                Participacion < 0.15,
			                "BAJA PRESENCIA",
			
			                "PRESENCIA"
			            )
			
			        VAR ColorEstado =
			            SWITCH(
			                TRUE(),
			
			                Estado = "SIN PRESENCIA",
			                "#f59e0b",
			
			                Estado = "BAJA PRESENCIA",
			                "#2fd9f4",
			
			                "#8f9095"
			            )
			
			        VAR TextoUCSP =
			            IF(
			                ISBLANK(ValorUCSP)
			                    || ValorUCSP = 0,
			                "—",
			                FORMAT(
			                    Participacion,
			                    "0.0%"
			                )
			            )
			
			        RETURN
			        "
			        <div style='
			            display:grid;
			            grid-template-columns:minmax(0,1fr) 90px 70px 100px;
			            align-items:center;
			            gap:10px;
			            min-height:40px;
			            border-bottom:1px solid #30353d;
			        '>
			
			            <div style='
			                color:#dee2ec;
			                font-size:11px;
			                line-height:14px;
			                font-weight:500;
			                white-space:nowrap;
			                overflow:hidden;
			                text-overflow:ellipsis;
			            '>
			                " & Programa & "
			            </div>
			
			            <div style='
			                color:#ffffff;
			                font-family:JetBrains Mono,monospace;
			                font-size:12px;
			                font-weight:700;
			                text-align:right;
			            '>
			                " & FORMAT(
			                    ValorMercado,
			                    "#,##0"
			                ) & "
			            </div>
			
			            <div style='
			                color:" & ColorEstado & ";
			                font-family:JetBrains Mono,monospace;
			                font-size:11px;
			                font-weight:700;
			                text-align:right;
			            '>
			                " & TextoUCSP & "
			            </div>
			
			            <div style='
			                color:" & ColorEstado & ";
			                font-size:8px;
			                line-height:10px;
			                font-weight:600;
			                text-align:right;
			                letter-spacing:0.04em;
			                text-transform:uppercase;
			            '>
			                " & Estado & "
			            </div>
			
			        </div>
			        ",
			        "",
			        [Mercado],
			        DESC
			    )
			
			VAR CantidadOportunidades =
			    COUNTROWS(
			        Top5Oportunidades
			    )
			
			RETURN
			"
			<div style='
			    width:100%;
			    height:100%;
			    box-sizing:border-box;
			    background:#171c23;
			    border:1px solid #30353d;
			    border-radius:8px;
			    padding:15px 17px;
			    font-family:Inter,Arial,sans-serif;
			    overflow:hidden;
			'>
			
			    <!-- HEADER -->
			
			    <div style='
			        display:flex;
			        justify-content:space-between;
			        align-items:flex-start;
			        margin-bottom:9px;
			    '>
			
			        <div>
			
			            <div style='
			                color:#dee2ec;
			                font-size:14px;
			                line-height:18px;
			                font-weight:700;
			                letter-spacing:0.06em;
			                text-transform:uppercase;
			            '>
			                OPORTUNIDADES DE MERCADO
			            </div>
			
			            <div style='
			                color:#8f9095;
			                font-size:9px;
			                line-height:12px;
			                margin-top:3px;
			                letter-spacing:0.05em;
			                text-transform:uppercase;
			            '>
			                PROGRAMAS CON DEMANDA Y BAJA PRESENCIA UCSP
			            </div>
			
			        </div>
			
			        <div style='
			            color:#2fd9f4;
			            font-size:9px;
			            font-weight:600;
			            letter-spacing:0.06em;
			            text-transform:uppercase;
			        '>
			            TOP 5
			        </div>
			
			    </div>
			
			
			    <!-- COLUMN HEADERS -->
			
			    <div style='
			        display:grid;
			        grid-template-columns:minmax(0,1fr) 90px 70px 100px;
			        gap:10px;
			        padding:6px 0;
			        border-top:1px solid #45474b;
			        border-bottom:1px solid #45474b;
			    '>
			
			        <div style='
			            color:#8f9095;
			            font-size:8px;
			            font-weight:600;
			            letter-spacing:0.06em;
			            text-transform:uppercase;
			        '>
			            PROGRAMA
			        </div>
			
			        <div style='
			            color:#8f9095;
			            font-size:8px;
			            font-weight:600;
			            text-align:right;
			            letter-spacing:0.06em;
			            text-transform:uppercase;
			        '>
			            MERCADO
			        </div>
			
			        <div style='
			            color:#8f9095;
			            font-size:8px;
			            font-weight:600;
			            text-align:right;
			            letter-spacing:0.06em;
			            text-transform:uppercase;
			        '>
			            UCSP
			        </div>
			
			        <div style='
			            color:#8f9095;
			            font-size:8px;
			            font-weight:600;
			            text-align:right;
			            letter-spacing:0.06em;
			            text-transform:uppercase;
			        '>
			            LECTURA
			        </div>
			
			    </div>
			
			
			    <!-- ROWS -->
			
			    <div style='
			        height:calc(100% - 72px);
			        overflow:hidden;
			    '>
			
			        " & Filas & "
			
			    </div>
			
			
			    <!-- FOOTER -->
			
			    <div style='
			        border-top:1px solid #30353d;
			        margin-top:5px;
			        padding-top:6px;
			        color:#797d85;
			        font-size:8px;
			        line-height:11px;
			    '>
			        Identifica programas con volumen relevante en el mercado seleccionado
			        donde la presencia de la UCSP es inexistente o inferior al 15%.
			    </div>
			
			</div>
			"
		lineageTag: 79f4387c-3b95-46e7-9181-87a897920ede

	column Column
		formatString: 0
		lineageTag: f2b3f73a-7128-4d1e-8f73-0a0ed504c0cf
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Column]

		annotation SummarizationSetBy = Automatic

	partition HTML1 = calculated
		mode: import
		source = Row("Column", BLANK())

	annotation PBI_Id = db65a93becd14414b75bee1f2f45e5ae

	annotation 436ba87b-9c83-4389-a31b-ebd06a36be98 = {"Expression":""}

