			        justify-content:space-between;
			        align-items:flex-start;
			        margin-bottom:10px;
			    '>
			
			        <div>
			
			            <div style='
			                color:#dee2ec;
			                font-size:15px;
			                line-height:19px;
			                font-weight:700;
			                letter-spacing:0.05em;
			                text-transform:uppercase;
			            '>
			                TOP 5 PROGRAMAS
			            </div>
			
			            <div style='
			                color:#8f9095;
			                font-size:9px;
			                line-height:12px;
			                margin-top:3px;
			                letter-spacing:0.05em;
			                text-transform:uppercase;
			            '>
			                MAYOR VOLUMEN · MATRÍCULAS
			            </div>
			
			        </div>
			
			        <div style='
			            color:#2fd9f4;
