			        [Promedio Matrículas Mercado],
			        REMOVEFILTERS('dim_periodo'),
			        'dim_periodo'[ANIO] = 2025
			    )
			
			VAR Minimo =
			    MIN(
			        MIN(U2020, U2021),
			        MIN(
			            MIN(U2022, U2023),
			            MIN(
			                MIN(U2024, U2025),
			                MIN(
			                    MIN(M2020, M2021),
			                    MIN(
			                        MIN(M2022, M2023),
			                        MIN(M2024, M2025)
			                    )
			                )
			            )
			        )
